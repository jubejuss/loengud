<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- install.sh asendab __HOME__ ja __BIN__ ning kopeerib faili ~/Library/LaunchAgents/ -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ee.vileandkell.loengud</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN__</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Applications/Docker.app/Contents/Resources/bin</string>
    <key>LANG</key>
    <string>et_EE.UTF-8</string>
  </dict>
  <!-- iga 2 tunni järel + kohe sisselogimisel -->
  <key>StartInterval</key>
  <integer>7200</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/loengud.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/loengud.log</string>
</dict>
</plist>
